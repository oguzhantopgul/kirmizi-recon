# Anthropic API key for the agent's reasoning brain (Claude).
# Alternatively run `ant auth login` and leave this unset — the SDK resolves the profile.
ANTHROPIC_API_KEY=

# Optional: model / effort overrides (defaults live in kirmizi_recon/config.py).
# KIRMIZI_MODEL=claude-opus-5
# KIRMIZI_EFFORT=high

# Optional: path to a default engagement (scope) file so interactive use is just `--active`.
# KIRMIZI_ENGAGEMENT=./engagement.yaml
